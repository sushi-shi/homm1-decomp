    "repository": "homm2/homm2-buka",
    "revision": "e0689d3f71b2942b544fd677cb54085a13503d7b",
    "use": "Corresponding source operations and ordinary semantic local names or plain aliases only. HoMM1 types, constants and behavior are checked against retail; no suffixed-name search or permutation was used."
  },
  "changes": {
    "inputManager::MakeScanCodeTable": "Correct INPUT_SCAN_SEMICOLON from apostrophe to semicolon. Retail +0x211 writes word 0x3b to this+0x28a, versus inherited candidate 0x27. Preferred donor assigns ';' to the same scan code; the apostrophe entry remains unchanged.",
    "BlitBitmapToScreen": "Compare sourceBitmap before the window-manager screen pointer; retail loads the parameter into ECX at +0xb and compares against [EAX+0x42] at +0xe.",
    "SetMenuStatus": "Use corresponding donor winWidth local name; other declarations, types, calls and behavior are unchanged. This swaps only width and height frame placement.",
    "SetMenus": "Use donor index/count/match/disabled and plain pos alias for the same loop, lookup and menu-state locals. The disabled and matched-row locals exchange slots; the remaining local slots agree with retail.",
    "WGUpdatePalette": "Use corresponding donor deviceContext and plain idx alias. The palette index occupies EBP-4, result EBP-8 and device context EBP-12 as in retail.",
    "WriteModemPacket": "Increment encoded output position before the input pointer, also in the donor. Complete instruction order now agrees; buffer/scalar frame placement remains non-exact. No padding or unused locals were added to force the frame.",
    "strip constructor": "Place firstBorderId before the slot index in firstBorderId + i + 1. Retail reads the parameter before the signed-word loop local; donor uses the same order.",
    "advManager::PuzzleDraw": "Place left before x in the DrawCell map-coordinate sum, consistent with the later GetCell lookup and retail parameter-first load. Local placement remains non-exact.",
    "game::NewGame": "Use player < giNumHumanPlayers in the restored-player loop. Retail loads the local before comparing against the global; other source and locale behavior is unchanged.",
    "combatManager::CastMassSpell": "Compare gCurLoadedSpellFileId before fileId, matching the retail global-then-local sign extensions. Local placement remains non-exact.",
    "townManager::BuildObj": "Remove the redundant sample = NULL immediately before LoadPlaySample assigns it. Retail has no such store; the corresponding donor also directly assigns the loaded sample.",
    "philAI::CheckReload": "Compute the denominator as 2.0f + friendly + enemyPressure, preserving retail floating-point order. The donor has the same base-first expression. Local placement remains non-exact."
  },
