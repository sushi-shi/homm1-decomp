    "repository": "homm2/homm2-buka",
    "revision": "e0689d3f71b2942b544fd677cb54085a13503d7b",
    "use": "Corresponding source structure, semantic local names and ordinary macro aliases; HoMM1 constants, types and behavior remain retail-backed."
  },
  "method": "Strict ordinary objdiff scores. Independently compare complete function bodies, instructions, operand widths/registers/constants, branch destinations, ordered reference identities/addends/types and trailing tables. Local displacement mapping describes residual frame differences only; it is not used in scoring, normalization or enrollment.",
  "changes": {
    "com_init": "Direct useDtr != 0 bitfield assignment; /G5 produces retail byte-register bit operations. Corresponding donor err/rv aliases and portTimeouts recover the retail local layout.",
    "game::ViewSpells": "Conditional spell-tab control ID produces retail arithmetic selection; local array/message placement remains unresolved.",
    "ViewSpellsHandler": "Spell-book top precedes widget index in all three spell lookups; lastHoverId precedes message.id in the hover comparison.",
    "game::ProcessOnMapHeroes": "Map-hero owner precedes player-count limit in the clamp comparison; local placement remains unresolved.",
    "fileRequester::Update": "Selected row precedes top-plus-row in the color comparison. Same instructions and references; physical local placement changes displacement widths and relocation positions.",
    "combatManager::DetermineEffectOfSpell": "Count-first ghost fight value; candidate spell effect precedes best-effect comparison. Local placement remains unresolved.",
    "combatManager::EffectSpellDamage": "Killed count precedes quantity clamp and hit-point/fight-value product. /G5 removes short-argument register clears absent from retail. Local placement remains unresolved.",
    "swapManager::SplitMons": "Destination indexed creature precedes selected creature in merge comparison; local placement remains unresolved.",
    "townManager::SplitArmy": "Pending indexed creature precedes selected creature. Corrects gArmyNames to retail gArmyNamesPlural for the prompt; local placement remains unresolved.",
    "game::LoadGame": "Day, week, month order in current-turn sum; local placement remains unresolved.",
    "game::TransmitSaveGame": "Packet index precedes block offset in acknowledgment indexing; local placement remains unresolved.",
    "hero::HeroView": "Player-color term precedes hero class in crest filename; remaining mobility precedes the clamp limit. Corresponding HoMM2 SetupHeroView names heroLuck, moraleValue and magnitude restore the retail frame without changing local types or adding locals.",
    "PopNetBox": "Keyboard character is explicitly keyCode & 0xff. Blink deadline and message deadline precede KBTickCount; the latter accounts for retail saved ESI. Local placement remains unresolved.",
    "philAI::StrategicValueOfPosition": "Opponent survival complement precedes distance weighting in both danger products; current survival chance precedes its danger modifier. HoMM1 constants retained. Local placement remains unresolved.",
    "philAI::FightValueOfStack": "Count-first stack value and constant-first count modifier; lower spell-power conditional arm first; inclusive spell-charge threshold; spellScore precedes maximum comparison. HoMM1 thresholds and formulas retained. Local placement remains unresolved.",
    "game::RandomizeEvents": "Conditional skeleton reward, compound willing-flag OR and resource-base subtraction, and indexed mine-cell trigger comparison first. Retail absence of saved EBX/ESI is reproduced. HoMM1 event probabilities retained; local placement remains unresolved."
  },
