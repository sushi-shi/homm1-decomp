    "repository": "homm2/homm2-buka",
    "revision": "e0689d3f71b2942b544fd677cb54085a13503d7b",
    "use": "Signed iLastSeed, SGenRand plain ret local (the donor result macro spelling), the nested FileSize null checks, and explicit float conversion of random attention terms. Other corrections follow HoMM1 retail operands and call structure."
  },
  "changes": {
    "SGenRand": "Recover signed seed type and corresponding plain donor ret local. Complete instructions, physical local placement and references now match. SRandom, SIncRandomize and SRand preserve their exact complete bodies with the corrected data identity.",
    "FileSize": "Restore the two nested file-null checks present in both the preferred donor and retail. FileError, seek, size read and close operations remain intact. Complete body and references are exact.",
    "InterpretCommandLine": "Restore the missing gbNoSound=0 store after parsing arguments, so the legacy /S option does not leave sound disabled. Restore direct index-first Boolean assignment of each human-player flag. Complete body, jump tables and references are exact.",
    "GetGameAttentionValue": "Restore explicit float conversion of each Random(0,100)/500.0 term before adding 0.23. VC6 emits the two retail FST scratch stores without adding source locals. Complete body and references are exact.",
    "recruitUnit::Open": "Compare maximum recruitment count before available count when clamping. Complete body and references are exact.",
    "swapManager::SwapMons": "Compare indexed troop type first in both merge searches and the found slot first before moving the remaining stack. HoMM1 merging and transfer rules are retained; complete body and references are exact.",
    "combatManager::LoadIcons": "Restore signed-byte arms for the castle-side conditional index. HoMM1 attacker=1 and defender=0 are retained. Complete body and references are exact.",
    "philAI::GoodAdjacent": "Restore hero-coordinate-first sums. Complete instructions and ordered references correspond; local placement remains non-exact.",
    "HandleViewGeneral": "Store dialog selection into message.id, then assign message.command from that field. Retail reloads the field; the inherited chained assignment copied the constant instead. Complete instructions and ordered references correspond; local placement remains non-exact.",
    "bitmap::Write": "Restore immediate return after a failed output-file open. Successful palette/pixel writes and cleanup are retained. Retail allocates a 20-byte frame while the current body allocates 16 bytes; this remains unresolved. No dummy local was added."
  },
