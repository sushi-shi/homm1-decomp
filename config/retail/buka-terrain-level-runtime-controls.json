  "changes": {
    "hero::CheckLevel": "Level-first equality and roll-first skill threshold comparisons; physical local placement remains unresolved.",
    "game::SetupTowns": "Map-extra owner precedes player count in the clamp comparison; physical local placement remains unresolved.",
    "game::ClaimMine": "Flag frame precedes player color in the sum; physical local placement remains unresolved.",
    "combatManager::MoreTreesNear": "Origin-first coordinate sums; physical local placement remains unresolved.",
    "advManager::ValidMove": "New-coordinate and origin-first cell index sums; physical local placement remains unresolved.",
    "ComputeUALoc": "Random call precedes hint-chance field read; corresponding plain donor triesCount local restores retail stack placement.",
    "game::RandomizeTown": "Conditional special-building assignment; physical local placement remains unresolved.",
    "advManager::FindAdjacentMonster": "Separate edge-bound assignments instead of conditional expressions; removes the two compiler temporary slots absent from retail.",
    "game::ShowScenInfo": "Conditional player-index assignment with index-minus-one branch first; restores the compiler temporary. Physical local placement remains unresolved.",
    "philAI::CheckBuyStuff": "Direct GAME_TOWN_NONE store into boat choice instead of reloading the shipyard choice; corresponding donor bought/bestBuy local names.",
    "combatManager::RawEffectSpellInfluence": "Quantity-first stack value product, corresponding donor worth local, and worth * slow modifier * (speed - 1) floating-point order.",
    "CanBuy": "Less-than mage-guild clamp arm first; preserves the original level limit.",
    "CanBuild": "Town-type-first dwelling requirement index with grouped building offset; required mask precedes building bits in the AND.",
    "QuickViewWait": "Direct Boolean assignment of the three event comparisons; compiler supplies the retail temporary slot.",
    "ResizeWindow": "Conditional coordinate assignments; corresponding donor windowX/windowRect/targetY locals. windowRect is the donor plain compiler macro spelling.",
    "com_rcv": "Requested-count-first conditional minimum; corresponding donor err/bytesRead/success/n locals. err and n are donor plain compiler macro spellings.",
    "combatManager::ResetMouse": "Conditional field ID assignment with y <= boundary arm first, producing SETG/DEC/AND in retail.",
    "army::GetAttackMask": "Conditional blocked-mask and direction-count assignments; physical local placement remains unresolved.",
    "calc_crc": "Direct Boolean low-bit OR with mask-first operand order; CRC polynomial and all loop bounds retained. Physical local placement remains unresolved.",
    "advManager::DoWhirlpool": "Count-first stack worth product and value-first minimum comparison; corresponding donor selectedSlot/creatureValue names and lowestValue-before-creatureValue declaration order.",
    "combatManager::EffectSpellResurrect": "Count-first clamp sum and fight-value product, corresponding donor target/count locals; HoMM1 resurrection rules retained."
  },
