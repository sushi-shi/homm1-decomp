  "changes": {
    "MoveOrigin": "Origin-before-cursor coordinate sums match retail and the donor.",
    "FizzleForward": "Early return when drawing is disabled; separate pixel-pointer increments, direct lookup expression, donor local order, ordinary delete expressions and retail row/timer operand order. No palette-fade additions from HoMM2.",
    "DrawToBuffer/DimToBuffer": "Coordinates precede entry offsets; top precedes frame height; extent comparisons begin with the member value, as in the donor. HoMM1 dimensions and clipping behavior retained.",
    "FillToBuffer": "Access each typed frame entry directly; retail has no cached entry local.",
    "ClipIconToBitmap": "Positive inside-rectangle branch; separate nonzero-skip/end-command branches; retail row/run/clip arithmetic and comparison order.",
    "heroWindow constructor": "Chained null initialization instead of reloading the previously cleared member.",
    "heroWindowManager Open/RemoveWindow": "Retail early failure/null returns, message-mask store before priority, and direct list-member updates without cached next/previous locals.",
    "UpdateScreenRegion": "Read mouse coordinates before clearing the flag; separate horizontal and vertical overlap branches. Complete instruction/reference correspondence retains non-exact local offsets.",
    "FadeScreen": "Promote saved flags and the global saved update before OR into the word member, without an intermediate byte assignment.",
    "FadeIn/FadeOut": "Native bool completion flag and donor pal name; no EH frame in retail despite constructor calls. An additional retail temporary assignment remains unexplained and these bodies remain non-exact."
  },
  "instruction_control_method": "All instructions through the sole return, ordered relocation identities/addends, branch destination indices and trailing tables/bytes are checked. Consistent injective negative-EBP slot correspondence is inspection only; strict scoring is unchanged.",
