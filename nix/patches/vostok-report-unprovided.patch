+/// Unknown names are retained verbatim only for diagnostic objects. Every
+/// occurrence is recorded so callers can withhold the owning function from
+/// verified coverage. The default still rejects the first missing identity.
+pub struct IdentityReport {
+    diagnostic: bool,
+    rows: BTreeMap<usize, (usize, String)>,
+}
+
+impl IdentityReport {
+    pub fn new(diagnostic: bool) -> Self {
+        Self { diagnostic, rows: BTreeMap::new() }
+    }
+
+    fn check(&mut self, name: RawString<'_>, target: usize, site: usize) -> anyhow::Result<()> {
+        if !self.diagnostic {
+            return refuse_unprovisioned(name, target);
+        }
+        if name.as_bytes().starts_with(UNPROVISIONED_DATA_PREFIX) {
+            self.rows.insert(site, (target, name.to_string().into_owned()));
+        }
+        Ok(())
+    }
+
+    pub fn len(&self) -> usize { self.rows.len() }
+
+    pub fn tsv(&self) -> String {
+        let mut out = String::from("site_rva\ttarget_rva\tname\n");
+        for (site, (target, name)) in &self.rows {
+            out.push_str(&format!("0x{site:08x}\t0x{target:08x}\t{name}\n"));
+        }
+        out
+    }
+}
