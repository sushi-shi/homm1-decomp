+        assert_eq!(
+            iat.rva_for_offset(pdb2::PdbInternalSectionOffset {
+                section: 3,
+                offset: 0x210,
+            }),
+            None
+        );
+        assert_eq!(
+            iat.rva_for_offset(pdb2::PdbInternalSectionOffset {
+                section: 4,
+                offset: 0x220,
+            }),
+            None
+        );
+    }
