+fn absolute_sites(
+    directory: Option<&[u8]>,
+    manifest: Option<&RelocManifest>,
+) -> anyhow::Result<Vec<usize>> {
+    let Some(data) = directory else {
+        return manifest.map(|m| m.sites().to_vec()).ok_or_else(|| {
+            anyhow::anyhow!("Missing PE base relocation directory; supply --reloc-manifest")
+        });
+    };
+    // A retained PE directory takes precedence, as in the shared HoMM1 reader.
+    let mut sites = Vec::new();
+    let mut pos = 0;
+    while pos < data.len() {
+        anyhow::ensure!(
+            pos + HEADER_SIZE <= data.len(),
+            "truncated base relocation header"
+        );
+        let RelocHeader {
+            page_rva,
+            block_size,
+        } = bytemuck::pod_read_unaligned(&data[pos..pos + HEADER_SIZE]);
+        if block_size == 0 {
+            break;
+        }
+        let size = block_size.to_usize();
+        anyhow::ensure!(
+            size >= HEADER_SIZE && size % 2 == 0 && size <= data.len() - pos,
+            "invalid base relocation block"
+        );
+        for raw in data[pos + HEADER_SIZE..pos + size].chunks_exact(2) {
+            let entry = u16::from_le_bytes([raw[0], raw[1]]);
+            if entry >> 12 == 3 {
+                sites.push(
+                    page_rva
+                        .checked_add(u32::from(entry & 0xfff))
+                        .ok_or_else(|| anyhow::anyhow!("base relocation site overflows"))?
+                        .to_usize(),
+                );
+            }
+        }
+        pos += size;
+    }
+    sites.sort_unstable();
+    sites.dedup();
+    Ok(sites)
 }

