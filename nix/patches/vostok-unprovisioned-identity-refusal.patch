+
+        let synthetic: RawString<'static> = b"DAT_005f0af0".as_slice().into();
+        assert!(refuse_unprovisioned(synthetic, 0x1f0af0).is_ok());
+        let real: RawString<'static> = b"?g_cmdBitTable@@3PBGB".as_slice().into();
