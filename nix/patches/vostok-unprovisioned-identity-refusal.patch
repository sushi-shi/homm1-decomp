     #[test]
+    fn unprovisioned_fence_is_refused_but_synthetic_and_real_names_pass() {
+        let fence: RawString<'static> = b"UNPROVISIONED_00653c34".as_slice().into();
+        let err = refuse_unprovisioned(fence, 0x253c34).unwrap_err().to_string();
