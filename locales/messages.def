HOMM1_MESSAGE("table.gStatDesc.0", "Your attack skill is a bonus added to each creature's attack skill.")
HOMM1_MESSAGE("table.gStatDesc.1", "Your defense skill is a bonus added to each creature's defense skill.")
HOMM1_MESSAGE("table.gStatDesc.2", "Your spell power determines the length or power of a spell.")
HOMM1_MESSAGE("table.gStatDesc.3", "Your knowledge is the number of each spell you are able to memorize.")
HOMM1_MESSAGE("table.gStatDesc.4", "Your siege skill is the number of times your hero can shoot the catapult in one turn while attempting to siege a castle.")
HOMM1_MESSAGE("table.gStatNames.0", "Attack Skill")
HOMM1_MESSAGE("table.gStatNames.1", "Defense Skill")
HOMM1_MESSAGE("table.gStatNames.2", "Spell Power")
HOMM1_MESSAGE("table.gStatNames.3", "Knowledge")
HOMM1_MESSAGE("table.gStatNames.4", "Siege Skill")
HOMM1_MESSAGE("table.gArtifactDesc.0", "Ultimate Book\n(+12 Knowledge)\n\nThe Ultimate Book of Knowledge increases your knowledge by 12.")
HOMM1_MESSAGE("table.gArtifactDesc.1", "Ultimate Sword\n(+12 Attack)\n\nThe Ultimate Sword of Dominion increases your attack skill by 12.")
HOMM1_MESSAGE("table.gArtifactDesc.2", "Ultimate Cloak\n(+12 Defense)\n\nThe Ultimate Cloak of Protection increases your defense skill by 12.")
HOMM1_MESSAGE("table.gArtifactDesc.3", "Ultimate Wand\n(+12 Spell Power)\n\nThe Ultimate Wand of Magic increases your spell power by 12.")
HOMM1_MESSAGE("table.gArtifactDesc.4", "Arcane Necklace\n(+4 Spell Power)\n\nThe Arcane Necklace of Magic increases your spell power by 4.")
HOMM1_MESSAGE("table.gArtifactDesc.5", "Caster's Bracelet\n(+2 Spell Power)\n\nThe Caster's Bracelet of Magic increases your spell power by 2.")
HOMM1_MESSAGE("table.gArtifactDesc.6", "Mage's Ring\n(+2 Spell Power)\n\nThe Mage's Ring of Power increases your spell power by 2.")
HOMM1_MESSAGE("table.gArtifactDesc.7", "Witches Broach\n(+3 Spell Power)\n\nThe Witch's Broach of Magic increases your spell power by 3.")
HOMM1_MESSAGE("table.gArtifactDesc.8", "Medal\n\nThe Medal of Valor increases your morale.")
HOMM1_MESSAGE("table.gArtifactDesc.9", "Medal\n\nThe Medal of Courage increases your morale.")
HOMM1_MESSAGE("table.gArtifactDesc.10", "Medal\n\nThe Medal of Honor increases your morale.")
HOMM1_MESSAGE("table.gArtifactDesc.11", "Medal\n\nThe Medal of Distinction increases your morale.")
HOMM1_MESSAGE("table.gArtifactDesc.12", "Fizbin\n\nThe Fizbin of Misfortune greatly decreases your morale.")
HOMM1_MESSAGE("table.gArtifactDesc.13", "Thunder Mace\n(+1 Attack)\n\nThe Thunder Mace of Dominion increases your attack skill by 1.")
HOMM1_MESSAGE("table.gArtifactDesc.14", "Armored Gauntlets\n(+1 Defense)\n\nThe Armored Gauntlets of Protection increase your defense skill by 1.")
HOMM1_MESSAGE("table.gArtifactDesc.15", "Defender Helm\n(+1 Defense)\n\nThe Defender Helm of Protection increases your defense skill by 1.")
HOMM1_MESSAGE("table.gArtifactDesc.16", "Giant Flail\n(+1 Attack)\n\nThe Giant Flail of Dominion increases your attack skill by 1.")
HOMM1_MESSAGE("table.gArtifactDesc.17", "Ballista\n\nThe Ballista of Quickness lets your catapult fire twice per combat round.")
HOMM1_MESSAGE("table.gArtifactDesc.18", "Stealth Shield\n(+2 Defense)\n\nThe Stealth Shield of Protection increases your defense skill by 2.")
HOMM1_MESSAGE("table.gArtifactDesc.19", "Dragon Sword\n(+3 Attack)\n\nThe Dragon Sword of Dominion increases your attack skill by 3.")
HOMM1_MESSAGE("table.gArtifactDesc.20", "Power Axe\n(+2 Attack)\n\nThe Power Axe of Dominion increases your attack skill by 2.")
HOMM1_MESSAGE("table.gArtifactDesc.21", "Divine Breastplate\n(+3 Defense)\n\nThe Divine Breastplate of Protection increases your defense skill by 3.")
HOMM1_MESSAGE("table.gArtifactDesc.22", "Minor Scroll\n(+2 Knowledge)\n\nThe Minor Scroll of Knowledge increases your knowledge by 2.")
HOMM1_MESSAGE("table.gArtifactDesc.23", "Major Scroll\n(+3 Knowledge)\n\nThe Major Scroll of Knowledge increases your knowledge by 3.")
HOMM1_MESSAGE("table.gArtifactDesc.24", "Superior Scroll\n(+4 Knowledge)\n\nThe Superior Scroll of Knowledge increases your knowledge by 4.")
HOMM1_MESSAGE("table.gArtifactDesc.25", "Foremost Scroll\n(+5 Knowledge)\n\nThe Foremost Scroll of Knowledge increases your knowledge by 5.")
HOMM1_MESSAGE("table.gArtifactDesc.26", "Endless Sack\n\nThe Endless Sack of Gold provides you with 1000 gold per day.")
HOMM1_MESSAGE("table.gArtifactDesc.27", "Endless Bag\n\nThe Endless Bag of Gold provides you with 750 gold per day.")
HOMM1_MESSAGE("table.gArtifactDesc.28", "Endless Purse\n\nThe Endless Purse of Gold provides you with 500 gold per day.")
HOMM1_MESSAGE("table.gArtifactDesc.29", "Nomad Boots\n\nThe Nomad Boots of Mobility increase your movement on land.")
HOMM1_MESSAGE("table.gArtifactDesc.30", "Traveler's Boots\n\nThe Traveler's Boots of Mobility increase your movement on land.")
HOMM1_MESSAGE("table.gArtifactDesc.31", "Rabbit's Foot\n\nThe Lucky Rabbit's Foot increases your luck in combat.")
HOMM1_MESSAGE("table.gArtifactDesc.32", "Horseshoe\n\nThe Golden Horseshoe increases your luck in combat.")
HOMM1_MESSAGE("table.gArtifactDesc.33", "Coin\n\nThe Gambler's Lucky Coin increases your luck in combat.")
HOMM1_MESSAGE("table.gArtifactDesc.34", "Clover\n\nThe Four-Leaf Clover increases your luck in combat.")
HOMM1_MESSAGE("table.gArtifactDesc.35", "Compass\n\nThe True Compass of Mobility increases your movement on land and sea.")
HOMM1_MESSAGE("table.gArtifactDesc.36", "Astrolabe\n\nThe Sailors' Astrolabe of Mobility increases your movement on sea.")
HOMM1_MESSAGE("table.gArtifactDesc.37", "Magic Book\n\nThe Magic Book enables you to cast spells.")
