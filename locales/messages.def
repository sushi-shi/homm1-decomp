HOMM1_MESSAGE("table.gNeutralBuildingNames.6", "Castle")
HOMM1_MESSAGE("table.gCampaignWinTexts.0", "Gateway has fallen!  The other lords have abandoned their castles and fled.  They have alerted their homelands and now gather their forces.  Speed is of the essence.")
HOMM1_MESSAGE("table.gCampaignWinTexts.1", "The Archipelago of the Ancients has been subdued and added to your domain.  On the horizon lies a vast, unexplored - and hostile - continent.")
HOMM1_MESSAGE("table.gCampaignWinTexts.2", "The healing power of the Eye of Goros spreads throughout the land.  The population unites behind you and the other lords retreat.  The war for domination begins.")
HOMM1_MESSAGE("table.gCampaignWinTexts.3", "With your victory, the other lords have made their final retreat.  They must each in turn be fought one-on-one in their homelands, and their personal castles must be captured.")
HOMM1_MESSAGE("table.gCampaignWinTexts.4", "The knights are broken in battle!  You have conquered their homeland.")
HOMM1_MESSAGE("table.gCampaignWinTexts.5", "The barbarian castle has been overthrown and their army scattered!")
HOMM1_MESSAGE("table.gCampaignWinTexts.6", "You have burst through the forest maze and destroyed Lamanda's castle.")
HOMM1_MESSAGE("table.gCampaignWinTexts.7", "You have followed the gargoyles to the castle of Lord Alamar and have shattered the might of the warlocks.")
HOMM1_MESSAGE("table.gCampaignWinTexts.8", "The dragons join your cause and the competing warlords capitulate.  You now rule a vast and united land as the one true King!")
