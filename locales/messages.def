HOMM1_MESSAGE("table.gCPanelHelp.0", "Start a single or multi-player game.")
HOMM1_MESSAGE("table.gCPanelHelp.1", "Load a previously saved game.")
HOMM1_MESSAGE("table.gCPanelHelp.2", "Quit Heroes of Might and Magic and return to the DOS prompt.")
HOMM1_MESSAGE("table.gCPanelHelp.3", "Exit this menu without doing anything.")
HOMM1_MESSAGE("table.gCPanelHelp.4", "Save the current game.")
HOMM1_MESSAGE("table.gCPanelHelp.5", "Toggle ambient music on/off")
HOMM1_MESSAGE("table.gCPanelHelp.6", "Toggle foreground sounds on/off")
HOMM1_MESSAGE("table.gCPanelHelp.7", "Change the speed at which Heroes move on the main screen.")
HOMM1_MESSAGE("table.gCPanelHelp.8", "Change the quality level of the sound.  CD stereo sounds the best, and usually is less of a drag on system performance, because no processing is required.  However, some systems may not be set up to handle CD stereo, so 8 bit sound is the fallback.")
HOMM1_MESSAGE("table.gCPanelHelp.9", "Toggle 'Show Path' on/off.  If 'Show Path' is on, your first click on a map location will show the path to get there, your second will start you moving. If this option is off, one click starts you moving immediately.")
HOMM1_MESSAGE("table.gCPanelHelp.10", "Toggle 'Show Enemy Moves' on/off.  If on, all enemies moving within your visible area will be shown.  If off, no computer movement will be shown.  Note that this option is automatically set to off during network and modem play.")
HOMM1_MESSAGE("table.gCPanelHelp.11", "View information on the scenario you are currently playing.")
