HOMM1_MESSAGE("table.gSpellDesc.0", "Fireball\n\nCauses a giant fireball to strike the selected area, damaging all nearby creatures.")
HOMM1_MESSAGE("table.gSpellDesc.1", "Lightning Bolt\n\nCauses a bolt of electrical energy to strike the selected creature.")
HOMM1_MESSAGE("table.gSpellDesc.2", "Teleport\n\nTeleports the creature you select to any open position on the battlefield.")
HOMM1_MESSAGE("table.gSpellDesc.3", "Cure\n\nRemoves all negative spells cast upon your forces.")
HOMM1_MESSAGE("table.gSpellDesc.4", "Resurrect\n\nResurrects creatures from a damaged monster group.")
HOMM1_MESSAGE("table.gSpellDesc.5", "Haste\n\nIncreases the speed of any creature to 'very fast'.")
HOMM1_MESSAGE("table.gSpellDesc.6", "Slow\n\nSlows down even the fastest enemy creature.")
HOMM1_MESSAGE("table.gSpellDesc.7", "Blind\n\nClouds the affected creatures' eyes, preventing them from moving.")
HOMM1_MESSAGE("table.gSpellDesc.8", "Bless\n\nCauses the selected creatures to inflict maximum damage.")
HOMM1_MESSAGE("table.gSpellDesc.9", "Protection\n\nMagically increases the defense skill of the selected creatures.")
HOMM1_MESSAGE("table.gSpellDesc.10", "Curse\n\nCauses the selected creatures to inflict minimum damage.")
HOMM1_MESSAGE("table.gSpellDesc.11", "Turn Undead\n\nInstantly sends a group of ghosts back to the grave.")
HOMM1_MESSAGE("table.gSpellDesc.12", "Anti-Magic\n\nPrevents harmful magic against the selected creatures.")
HOMM1_MESSAGE("table.gSpellDesc.13", "Dispel Magic\n\nRemoves all magic spells from all parties in the battle.")
HOMM1_MESSAGE("table.gSpellDesc.14", "Berserk\n\nCauses a creature to attack its nearest neighbor.")
HOMM1_MESSAGE("table.gSpellDesc.15", "Armageddon\n\nHoly terror strikes the battlefield, causing severe damage to all creatures.")
HOMM1_MESSAGE("table.gSpellDesc.16", "Elemental Storm\n\nMagical elements pour down on the battlefield, damaging all creatures.")
HOMM1_MESSAGE("table.gSpellDesc.17", "Meteor Shower\n\nA rain of rocks strikes an area of the battlefield, damaging all nearby creatures.")
HOMM1_MESSAGE("table.gSpellDesc.18", "Paralyze\n\nThe targeted creatures are paralyzed, unable to move or retaliate.")
HOMM1_MESSAGE("table.gSpellDesc.19", "View Mines\n\nCauses all mines across the land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.20", "View Resources\n\nCauses all resources across the land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.21", "View Artifacts\n\nCauses all artifacts across the land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.22", "View Towns\n\nCauses all towns and castles across the land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.23", "View Heroes\n\nCauses all Heroes across the land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.24", "View All\n\nCauses the entire land to become visible.")
HOMM1_MESSAGE("table.gSpellDesc.25", "Identify Hero\n\nAllows the caster to view detailed information on enemy Heroes.")
HOMM1_MESSAGE("table.gSpellDesc.26", "Summon Boat\n\nSummons the nearest unoccupied, friendly boat to an adjacent shore location.  A friendly boat is one which you just built or were the most recent player to occupy.")
HOMM1_MESSAGE("table.gSpellDesc.27", "Dimension Door\n\nAllows the caster to magically transport himself to a nearby location.")
HOMM1_MESSAGE("table.gSpellDesc.28", "Town Gate\n\nReturns the caster to any town or castle currently owned.")
