msgstr "Quit Heroes of Might and Magic and return to the DOS prompt."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gCPanelHelp.3"
msgstr "Exit this menu without doing anything."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
