#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.0"
msgstr "Fireball\n\nCauses a giant fireball to strike the selected area, damaging all nearby creatures.\n\nDoes %d points of damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.1"
msgstr "Lightning Bolt\n\nCauses a bolt of electrical energy to strike the selected creature.\n\nDoes %d points of damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.2"
msgstr "Teleport\n\nTeleports the creature you select to any open position on the battlefield."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.3"
msgstr "Cure\n\nRemoves all negative spells cast upon your forces."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.4"
msgstr "Resurrect\n\nResurrects creatures from a damaged monster group.\n\nRestores %d hit points."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.5"
msgstr "Haste\n\nIncreases the speed of any creature to 'very fast'."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.6"
msgstr "Slow\n\nSlows down even the fastest enemy creature."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.7"
msgstr "Blind\n\nClouds the affected creatures' eyes, preventing them from moving."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.8"
msgstr "Bless\n\nCauses the selected creatures to inflict maximum damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.9"
msgstr "Protection\n\nMagically increases the defense skill of the selected creatures."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.10"
msgstr "Curse\n\nCauses the selected creatures to inflict minimum damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.11"
msgstr "Turn Undead\n\nInstantly sends a group of ghosts back to the grave."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.12"
msgstr "Anti-Magic\n\nPrevents harmful magic against the selected creatures."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.13"
msgstr "Dispel Magic\n\nRemoves all magic spells from all parties in the battle."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.14"
msgstr "Berserk\n\nCauses a creature to attack its nearest neighbor."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.15"
msgstr "Armageddon\n\nHoly terror strikes the battlefield, causing severe damage to all creatures.\n\nDoes %d points of damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.16"
msgstr "Elemental Storm\n\nMagical elements pour down on the battlefield, damaging all creatures.\n\nDoes %d points of damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
#, c-format
msgid "table.gSpellDesc.17"
msgstr "Meteor Shower\n\nA rain of rocks strikes an area of the battlefield, damaging all nearby creatures.\n\nDoes %d points of damage."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.18"
msgstr "Paralyze\n\nThe targeted creatures are paralyzed, unable to move or retaliate."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.19"
msgstr "View Mines\n\nCauses all mines across the land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.20"
msgstr "View Resources\n\nCauses all resources across the land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.21"
msgstr "View Artifacts\n\nCauses all artifacts across the land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.22"
msgstr "View Towns\n\nCauses all towns and castles across the land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.23"
msgstr "View Heroes\n\nCauses all Heroes across the land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.24"
msgstr "View All\n\nCauses the entire land to become visible."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.25"
msgstr "Identify Hero\n\nAllows the caster to view detailed information on enemy Heroes."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.26"
msgstr "Summon Boat\n\nSummons the nearest unoccupied, friendly boat to an adjacent shore location.  A friendly boat is one which you just built or were the most recent player to occupy."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.27"
msgstr "Dimension Door\n\nAllows the caster to magically transport himself to a nearby location."

#: src/EDITOR/EDITOR.cpp src/SOURCE/KB.cpp
msgid "table.gSpellDesc.28"
msgstr "Town Gate\n\nReturns the caster to any town or castle currently owned."

