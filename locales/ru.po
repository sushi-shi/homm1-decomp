msgstr "Осада"

msgctxt "table.gArtifactDesc.0"
msgid "Ultimate Book\n(+12 Knowledge)\n\nThe Ultimate Book of Knowledge increases your knowledge by 12."
msgstr "Книга всезнания\n(Знания +12)\n\nКнига всезнания увеличивает Знания на 12 единиц."

msgctxt "table.gArtifactDesc.1"
msgid "Ultimate Sword\n(+12 Attack)\n\nThe Ultimate Sword of Dominion increases your attack skill by 12."
msgstr "Меч власти\n(Атака +12)\n\nМеч власти увеличивает навык атаки на 12 единиц."

msgctxt "table.gArtifactDesc.2"
msgid "Ultimate Cloak\n(+12 Defense)\n\nThe Ultimate Cloak of Protection increases your defense skill by 12."
msgstr "Защитная накидка\n(Защита +12)\n\nЗащитная накидка увеличивает защиту на 12 единиц."

msgctxt "table.gArtifactDesc.3"
msgid "Ultimate Wand\n(+12 Spell Power)\n\nThe Ultimate Wand of Magic increases your spell power by 12."
msgstr "Жезл магии\n(Сила магии +12)\n\nЖезл магии увеличивает силу заклинаний на 12 единиц."

msgctxt "table.gArtifactDesc.4"
msgid "Arcane Necklace\n(+4 Spell Power)\n\nThe Arcane Necklace of Magic increases your spell power by 4."
msgstr "Ожерелье тайной магии\n(Сила магии +4)\n\nОжерелье тайной магии увеличивает силу магии на 4 единицы."

msgctxt "table.gArtifactDesc.5"
msgid "Caster's Bracelet\n(+2 Spell Power)\n\nThe Caster's Bracelet of Magic increases your spell power by 2."
msgstr "Магический браслет\n(Сила магии +2)\n\nМагический браслет увеличивает силу заклинаний на 2 единицы."

msgctxt "table.gArtifactDesc.6"
msgid "Mage's Ring\n(+2 Spell Power)\n\nThe Mage's Ring of Power increases your spell power by 2."
msgstr "Кольцо мага\n(Сила магии +2)\n\nКольцо мага увеличивает силу магии на 2 единицы."

msgctxt "table.gArtifactDesc.7"
msgid "Witches Broach\n(+3 Spell Power)\n\nThe Witch's Broach of Magic increases your spell power by 3."
msgstr "Брошь ведьмы\n(Сила магии +3)\n\nБрошь ведьмы увеличивает силу магии на 3 единицы."

msgctxt "table.gArtifactDesc.8"
msgid "Medal\n\nThe Medal of Valor increases your morale."
msgstr "Медаль отваги\n\nМедаль отваги увеличивает мораль."

msgctxt "table.gArtifactDesc.9"
msgid "Medal\n\nThe Medal of Courage increases your morale."
msgstr "Медаль мужества\n\nМедаль мужества увеличивает мораль."

msgctxt "table.gArtifactDesc.10"
msgid "Medal\n\nThe Medal of Honor increases your morale."
msgstr "Медаль доблести\n\nМедаль доблести увеличивает мораль."

msgctxt "table.gArtifactDesc.11"
msgid "Medal\n\nThe Medal of Distinction increases your morale."
msgstr "Медаль почета\n\nМедаль почета увеличивает мораль."

msgctxt "table.gArtifactDesc.12"
msgid "Fizbin\n\nThe Fizbin of Misfortune greatly decreases your morale."
msgstr "Символ неудачи\n\nСимвол неудачи сильно уменьшает мораль."

msgctxt "table.gArtifactDesc.13"
msgid "Thunder Mace\n(+1 Attack)\n\nThe Thunder Mace of Dominion increases your attack skill by 1."
msgstr "Громовая палица\n(Атака +1)\n\nГромовая палица увеличивает навык атаки на 1 единицу."

msgctxt "table.gArtifactDesc.14"
msgid "Armored Gauntlets\n(+1 Defense)\n\nThe Armored Gauntlets of Protection increase your defense skill by 1."
msgstr "Защитная перчатка\n(Защита +1)\n\nЗащитная перчатка увеличивает навык защиты на 1 единицу."

msgctxt "table.gArtifactDesc.15"
msgid "Defender Helm\n(+1 Defense)\n\nThe Defender Helm of Protection increases your defense skill by 1."
msgstr "Шлем защитника\n(Защита +1)\n\nШлем защитника увеличивает навык защиты на 1 единицу."

msgctxt "table.gArtifactDesc.16"
msgid "Giant Flail\n(+1 Attack)\n\nThe Giant Flail of Dominion increases your attack skill by 1."
msgstr "Гигантский цеп\n(Атака +1)\n\nГигантский цеп увеличивает навык атаки на 1 единицу."

msgctxt "table.gArtifactDesc.17"
msgid "Ballista\n\nThe Ballista of Quickness lets your catapult fire twice per combat round."
msgstr "Баллиста\n\nБаллиста позволяет вашей катапульте дважды стрелять в один ход боя."

msgctxt "table.gArtifactDesc.18"
msgid "Stealth Shield\n(+2 Defense)\n\nThe Stealth Shield of Protection increases your defense skill by 2."
msgstr "Незримый щит\n(Защита +2)\n\nНезримый щит увеличивает навык защиты на 2 единицы."

msgctxt "table.gArtifactDesc.19"
msgid "Dragon Sword\n(+3 Attack)\n\nThe Dragon Sword of Dominion increases your attack skill by 3."
msgstr "Драконий меч\n(Атака +3)\n\nДраконий меч увеличивает навык атаки на 3 единицы."

msgctxt "table.gArtifactDesc.20"
msgid "Power Axe\n(+2 Attack)\n\nThe Power Axe of Dominion increases your attack skill by 2."
msgstr "Топор власти\n(Атака +2)\n\nТопор власти увеличивает навык атаки на 2 единицы."

msgctxt "table.gArtifactDesc.21"
msgid "Divine Breastplate\n(+3 Defense)\n\nThe Divine Breastplate of Protection increases your defense skill by 3."
msgstr "Божественный доспех\n(Защита +3)\n\nБожественный доспех увеличивает навык защиты на 3 единицы."

msgctxt "table.gArtifactDesc.22"
msgid "Minor Scroll\n(+2 Knowledge)\n\nThe Minor Scroll of Knowledge increases your knowledge by 2."
msgstr "Малый свиток знания\n(Знания +2)\n\nМалый свиток знания увеличивает Знания на 2 единицы."

msgctxt "table.gArtifactDesc.23"
msgid "Major Scroll\n(+3 Knowledge)\n\nThe Major Scroll of Knowledge increases your knowledge by 3."
msgstr "Большой свиток знания\n(Знания +3)\n\nБольшой свиток знания увеличивает Знания на 3 единицы."

msgctxt "table.gArtifactDesc.24"
msgid "Superior Scroll\n(+4 Knowledge)\n\nThe Superior Scroll of Knowledge increases your knowledge by 4."
msgstr "Могущественный свиток знания\n(Знания +4)\n\nМогущественный свиток знания увеличивает Знания на 4 единицы."

msgctxt "table.gArtifactDesc.25"
msgid "Foremost Scroll\n(+5 Knowledge)\n\nThe Foremost Scroll of Knowledge increases your knowledge by 5."
msgstr "Свиток высшего знания\n(Знания +5)\n\nСвиток высшего знания увеличивает Знания на 5 единиц."

msgctxt "table.gArtifactDesc.26"
msgid "Endless Sack\n\nThe Endless Sack of Gold provides you with 1000 gold per day."
msgstr "Бездонный мешок\n\nБездонный мешок приносит вам 1000 золотых в день."

msgctxt "table.gArtifactDesc.27"
msgid "Endless Bag\n\nThe Endless Bag of Gold provides you with 750 gold per day."
msgstr "Бездонная сума\n\nБездонная сума приносит вам 750 золотых в день."

msgctxt "table.gArtifactDesc.28"
msgid "Endless Purse\n\nThe Endless Purse of Gold provides you with 500 gold per day."
msgstr "Бездонный кошель\n\nБездонный кошель приносит вам 500 золотых в день."

msgctxt "table.gArtifactDesc.29"
msgid "Nomad Boots\n\nThe Nomad Boots of Mobility increase your movement on land."
msgstr "Башмаки кочевника\n\nБашмаки кочевника увеличивают дальность передвижения по суше."

msgctxt "table.gArtifactDesc.30"
msgid "Traveler's Boots\n\nThe Traveler's Boots of Mobility increase your movement on land."
msgstr "Башмаки путника\n\nБашмаки путника увеличивают подвижность отряда на суше."

msgctxt "table.gArtifactDesc.31"
msgid "Rabbit's Foot\n\nThe Lucky Rabbit's Foot increases your luck in combat."
msgstr "Лапка кролика\n\nЛапка кролика увеличивает удачу в бою."

msgctxt "table.gArtifactDesc.32"
msgid "Horseshoe\n\nThe Golden Horseshoe increases your luck in combat."
msgstr "Золотая подкова\n\nЗолотая подкова увеличивает удачу в бою."

msgctxt "table.gArtifactDesc.33"
msgid "Coin\n\nThe Gambler's Lucky Coin increases your luck in combat."
msgstr "Монета\n\nСчастливая монета увеличивает удачу в бою."

msgctxt "table.gArtifactDesc.34"
msgid "Clover\n\nThe Four-Leaf Clover increases your luck in combat."
msgstr "Клевер\n\nКлевер увеличивает удачу в бою."

msgctxt "table.gArtifactDesc.35"
msgid "Compass\n\nThe True Compass of Mobility increases your movement on land and sea."
msgstr "Компас\n\nКомпас увеличивает подвижность отряда на суше и на море."

msgctxt "table.gArtifactDesc.36"
msgid "Astrolabe\n\nThe Sailors' Astrolabe of Mobility increases your movement on sea."
msgstr "Астролябия\n\nАстролябия увеличивает подвижность отряда на море."

msgctxt "table.gArtifactDesc.37"
msgid "Magic Book\n\nThe Magic Book enables you to cast spells."
msgstr "Волшебная книга\n\nВолшебная книга позволяет направлять заклинания."

