msgctxt "table.gSpellDesc.0"
msgid "Fireball\n\nCauses a giant fireball to strike the selected area, damaging all nearby creatures."
msgstr "Огненный шар\n\nОгромный огненный шар взрывается над выбранным участком поля боя, поражая всех находящихся поблизости участников сражения."

msgctxt "table.gSpellDesc.1"
msgid "Lightning Bolt\n\nCauses a bolt of electrical energy to strike the selected creature."
msgstr "Молния\n\nМощный электрический разряд поражает выбранную группу воинов."

msgctxt "table.gSpellDesc.2"
msgid "Teleport\n\nTeleports the creature you select to any open position on the battlefield."
msgstr "Телепортация\n\nПереносит выбранную группу воинов в любое свободное место на поле боя."

msgctxt "table.gSpellDesc.3"
msgid "Cure\n\nRemoves all negative spells cast upon your forces."
msgstr "Лечение\n\nНейтрализует все враждебные чары, насланные на ваших воинов."

msgctxt "table.gSpellDesc.4"
msgid "Resurrect\n\nResurrects creatures from a damaged monster group."
msgstr "Воскрешение\n\nВоскрешает воинов в группе, которой был нанесен урон."

msgctxt "table.gSpellDesc.5"
msgid "Haste\n\nIncreases the speed of any creature to 'very fast'."
msgstr "Ускорение\n\nСкорость любой группы воинов становится 'очень высокой'."

msgctxt "table.gSpellDesc.6"
msgid "Slow\n\nSlows down even the fastest enemy creature."
msgstr "Замедление\n\nУменьшает скорость даже самой быстрой группы вражеских воинов."

msgctxt "table.gSpellDesc.7"
msgid "Blind\n\nClouds the affected creatures' eyes, preventing them from moving."
msgstr "Ослепление\n\nЗатуманивает взоры воинов в выбранной группе и тем самым не позволяет им перемещаться по полю боя."

msgctxt "table.gSpellDesc.8"
msgid "Bless\n\nCauses the selected creatures to inflict maximum damage."
msgstr "Благословение\n\nУвеличивает до максимума урон, наносимый выбранной группой воинов."

msgctxt "table.gSpellDesc.9"
msgid "Protection\n\nMagically increases the defense skill of the selected creatures."
msgstr "Защита\n\nУвеличивает навык защиты воинов выбранной группы."

msgctxt "table.gSpellDesc.10"
msgid "Curse\n\nCauses the selected creatures to inflict minimum damage."
msgstr "Проклятие\n\nУменьшает до минимума урон, причиняемый выбранной группой воинов."

msgctxt "table.gSpellDesc.11"
msgid "Turn Undead\n\nInstantly sends a group of ghosts back to the grave."
msgstr "Убить нежить\n\nМгновенно загоняет призраков в покинутые ими могилы."

msgctxt "table.gSpellDesc.12"
msgid "Anti-Magic\n\nPrevents harmful magic against the selected creatures."
msgstr "Антимагия\n\nДелает невозможным применение враждебных чар против выбранной группы воинов."

msgctxt "table.gSpellDesc.13"
msgid "Dispel Magic\n\nRemoves all magic spells from all parties in the battle."
msgstr "Снять чары\n\nНейтрализует любые чары, насланные на всех участников сражения."

msgctxt "table.gSpellDesc.14"
msgid "Berserk\n\nCauses a creature to attack its nearest neighbor."
msgstr "Берсерк\n\nЗаставляет выбранную группу воинов нападать на ближайшую к ней соседнюю группу."

msgctxt "table.gSpellDesc.15"
msgid "Armageddon\n\nHoly terror strikes the battlefield, causing severe damage to all creatures."
msgstr "Армагеддон\n\nМогущественные силы поражают всех участников сражения, нанося им жестокий урон."

msgctxt "table.gSpellDesc.16"
msgid "Elemental Storm\n\nMagical elements pour down on the battlefield, damaging all creatures."
msgstr "Шторм\n\nСилы стихий обрушиваются на поле боя, нанося урон всем участникам сражения."

msgctxt "table.gSpellDesc.17"
msgid "Meteor Shower\n\nA rain of rocks strikes an area of the battlefield, damaging all nearby creatures."
msgstr "Звездопад\n\nЗвездопад поражает выбранный участок поля боя, нанося урон всем находящимся поблизости участникам сражения."

msgctxt "table.gSpellDesc.18"
msgid "Paralyze\n\nThe targeted creatures are paralyzed, unable to move or retaliate."
msgstr "Паралич\n\nГруппу, против которой направлено это заклинание, поражает паралич, и она теряет способность передвигаться или отвечать на удары."

msgctxt "table.gSpellDesc.19"
msgid "View Mines\n\nCauses all mines across the land to become visible."
msgstr "Шахты\n\nДелает видимыми все шахты на игровой карте."

msgctxt "table.gSpellDesc.20"
msgid "View Resources\n\nCauses all resources across the land to become visible."
msgstr "Ресурсы\n\nДелает видимыми все ресурсы на игровой карте."

msgctxt "table.gSpellDesc.21"
msgid "View Artifacts\n\nCauses all artifacts across the land to become visible."
msgstr "Артефакты\n\nДелает видимыми все артефакты на игровой карте."

msgctxt "table.gSpellDesc.22"
msgid "View Towns\n\nCauses all towns and castles across the land to become visible."
msgstr "Города\n\nДелает видимыми все города и замки на игровой карте."

msgctxt "table.gSpellDesc.23"
msgid "View Heroes\n\nCauses all Heroes across the land to become visible."
msgstr "Герои\n\nДелает видимыми всех героев на игровой карте."

msgctxt "table.gSpellDesc.24"
msgid "View All\n\nCauses the entire land to become visible."
msgstr "Все\n\nДелает видимой всю игровую карту."

msgctxt "table.gSpellDesc.25"
msgid "Identify Hero\n\nAllows the caster to view detailed information on enemy Heroes."
msgstr "Опознать героя\n\nПозволяет получить подробную информацию о вражеских героях."

msgctxt "table.gSpellDesc.26"
msgid "Summon Boat\n\nSummons the nearest unoccupied, friendly boat to an adjacent shore location.  A friendly boat is one which you just built or were the most recent player to occupy."
msgstr "Корабль\n\nПереносит ближайший незанятый дружественный корабль в соответствующую точку побережья. Дружественным считается корабль, который вы только что построили, либо тот, на котором после вас никто не плавал."

msgctxt "table.gSpellDesc.27"
msgid "Dimension Door\n\nAllows the caster to magically transport himself to a nearby location."
msgstr "Портал\n\nПереносит вас в точку на карте, расположенную поблизости."

msgctxt "table.gSpellDesc.28"
msgid "Town Gate\n\nReturns the caster to any town or castle currently owned."
msgstr "Врата города\n\nПереносит вас в любой принадлежащий вам город или замок."

